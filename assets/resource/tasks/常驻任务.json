    "option": {
        "挂机等待至深渊挑战开启": {
            "type": "switch",
            "label": "挂机等待至深渊挑战开启",
            "description": "开启后，若当前时间早于 20:00，将挂机等待直至深渊挑战开启；关闭则不等待。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "停止深渊挑战任务": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "停止深渊挑战任务": {
                            "enabled": true
                        },
                        "深渊挑战等待提示": {
                            "focus": ""
                        }
                    }
                }
            ]
        },
        "选卡时间": {
            "type": "input",
            "inputs": [
                {
                    "name": "选卡分钟",
                    "description": "深渊挑战 20:00 开启。填写开启后经过的分钟数，到达该时间后才进行选卡。例如填写 20 表示 20:20 时选卡。范围 0-59。",
                    "default": "20",
                    "pipeline_type": "int",
                    "verify": "^[0-5]?\\d$",
                    "pattern_msg": "请输入 0-59 的数字"
                }
            ],
            "pipeline_override": {
                "深渊挑战选卡时间": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "minute": "{选卡分钟}"
                            }
                        }
                    }
                }
            }
        },
        "挂机直到族战开启": {
            "type": "switch",
            "label": "挂机直到族战开启",
            "description": "开启后，若当前时间早于 20:00，将挂机等待直至家族战开启；关闭则不等待。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "停止家族战任务": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "停止家族战任务": {
                            "enabled": true
                        },
                        "家族战等待提示": {
                            "focus": ""
                        }
                    }
                }
            ]
        },
        "混团本": {
            "type": "switch",
            "label": "混团本",
            "description": "开启后家族战期间会参加团本；关闭则不会参加团本。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "团队战点击加入战斗": {
                            "enabled": true
                        },
                        "识别到全员参战且有进入战场": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "团队战点击加入战斗": {
                            "enabled": false
                        },
                        "识别到全员参战且有进入战场": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "清S": {
            "type": "switch",
            "label": "清S",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "召令悬赏需要刷S": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "召令悬赏需要刷S": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "清SS+": {
            "type": "switch",
            "label": "清SS+",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "召令悬赏需要刷SS+": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "召令悬赏需要刷SS+": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "免费接力": {
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "备战副本点击接力": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "备战副本点击接力": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
